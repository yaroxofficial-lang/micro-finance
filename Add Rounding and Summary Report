
            // Round interest for accounting
            long roundedInterest = Math.round(interest);

            double finalBalance = depositAmount + interest;

            // Update summary totals
            totalDeposits += depositAmount;
            totalInterest += interest;

            // Display customer report
            System.out.println("\n--- CUSTOMER REPORT ---");
            System.out.println("Customer Name: " + name);
            System.out.println("Original Deposit: " + deposit);
            System.out.println("Calculated Interest: " + interest);
            System.out.println("Truncated Interest: " + truncatedInterest);
            System.out.println("Rounded Interest: " + roundedInterest);
            System.out.println("Final Balance: " + finalBalance);
        }

        // Generate management summary
        System.out.println("\n===== MANAGEMENT SUMMARY =====");

        System.out.println("Total Deposits: " + totalDeposits);

        System.out.println("Total Interest: " + totalInterest);

        System.out.println("Rounded Total Interest: "
                + Math.round(totalInterest));

        System.out.println("Total Savings Balance: "
                + (totalDeposits + totalInterest));

        System.out.println("\n===== END OF REPORT =====");

        input.close();
    }
}
